# --- Resend ---
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Where contact form submissions are delivered ---
# Your Gmail (or any inbox) that should receive enquiries.
CONTACT_TO_EMAIL=youraddress@gmail.com

# --- Sender address shown in the "From" field ---
# For quick testing you can leave the default below (Resend's shared test domain).
# To send from your own domain, verify it in Resend first, then use e.g.
#   CONTACT_FROM_EMAIL=BrandSethu <hello@yourdomain.com>
CONTACT_FROM_EMAIL=BrandSethu <onboarding@resend.dev>

# --- CORS ---
# The frontend origin(s) allowed to call this API. Comma-separate multiple.
# Use * to allow any origin (fine for testing, tighten for production).
# Example: ALLOWED_ORIGIN=http://localhost:5173,https://brandsethu.com
ALLOWED_ORIGIN=*

# --- Server port ---
PORT=3001
