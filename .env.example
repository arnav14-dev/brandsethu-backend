# --- Google Chat incoming webhook ---
# New enquiries are announced in a Google Chat space via this webhook.
# Create one in the space: Apps & integrations → Webhooks, then paste the URL.
# The `token` is a secret — put the real value in .env (gitignored), not here.
# If unset, Chat notifications are skipped (enquiries are still saved to the Google Form).
GOOGLE_CHAT_WEBHOOK=https://chat.googleapis.com/v1/spaces/XXXX/messages?key=XXXX&token=XXXX

# --- CORS ---
# The frontend origin(s) allowed to call this API. Comma-separate multiple.
# Use * to allow any origin (fine for testing, tighten for production).
# Example: ALLOWED_ORIGIN=http://localhost:5173,https://brandsethu.com
ALLOWED_ORIGIN=*

# --- Server port ---
PORT=3001
